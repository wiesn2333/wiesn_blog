---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ArticleList from "../components/ArticleList.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).map((article_data) => ({
    data: article_data.data,
    link: "article/" + article_data.id,
}));
---

<Layout title="Wiesn's Bookshelf">
    <Hero
        title="From The Bookshelf"
        description="Keep up with notes and stories."
    />
    <ArticleList articles={articles} />
</Layout>
