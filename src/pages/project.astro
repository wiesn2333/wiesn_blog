---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HatFactory from "../assets/hat_factory.svg";
---

<Layout title="Wiesn's Projects">
  <Hero title="Projects" description="Things I've built and tinkered with." />

  <section class="section">
    <div class="project-list">
      <ProjectCard
        href="https://github.com/wiesn2333/hat_factory"
        icon={HatFactory.src}
        title="帽子工厂"
        description="大号、中号和小号的都有"
        tags={["Preact", "Web"]}
      />
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 0 1rem 3rem;
  }
  @media (min-width: 1024px) {
    .section {
      padding-bottom: 4rem;
    }
  }
  .project-list {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
