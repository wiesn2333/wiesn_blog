---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Twitter from "../assets/twitter-x.svg";
import Github from "../assets/github.svg";
import BiliBili from "../assets/bilibili.svg";
---

<Layout title="关于维森 — Wiesn's Bookshelf">
    <Hero title="关于维森" description="一个在键盘和书本之间迷路的人" />

    <div class="card">
        <p>废物大学生，啥都不会，一事无成</p>
        <p class="emoji">😭</p>
        <div class="links">
            <a href="https://twitter.com/weisn2333" aria-label="Twitter">
                <img src={Twitter.src} />
            </a>
            <a href="https://github.com/wiesn2333" aria-label="GitHub">
                <img src={Github.src} />
            </a>
            <a
                href="https://space.bilibili.com/37298661/"
                aria-label="Bilibili"
            >
                <img src={BiliBili.src} />
            </a>
        </div>
    </div>
</Layout>

<style>
    .card {

        max-width: 64rem;
        margin: 15vh auto 0;
        padding: 2rem;
        border: 1px solid var(--shadow-color);
        border-radius: 4px;
        background: var(--background-color);
        box-shadow: inset 0 -2px 0 0 var(--shadow-color);
        text-align: center;
    }
    .card p {
        margin: 0;
        color: var(--label-color);
    }
    .emoji {
        margin-top: 1rem;
        font-size: 1.25rem;
    }
    .links {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        line-height: 0;
    }
    .links a {
        padding: 0.5rem;
        border-radius: 4px;
        transition: background-color 0.15s;
    }
    .links a:hover {
        background: var(--shadow-color);
    }
    .links img {
        width: 1.25rem;
        height: 1.25rem;
    }
    @media (prefers-color-scheme: dark) {
        .links img {
            filter: invert(1);
        }
    }
</style>
