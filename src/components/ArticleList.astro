---
import ArticleCard from "./ArticleCard.astro";

interface Props {
  articles: Array<{
    data: {
      title: string;
      description: string;
      date: Date;
      tags: string[];
    };
    link: string;
  }>;
}

const { articles } = Astro.props;
---

<div class="article-list">
  {articles.length > 0 ? (
    articles.map((a) => <ArticleCard article={a.data} link={a.link} />)
  ) : (
    <p class="empty">No Articles Found</p>
  )}
</div>

<style>
  .article-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }
  .empty {
    text-align: center;
    color: var(--text-color);
    padding: 2rem 0;
  }
</style>
