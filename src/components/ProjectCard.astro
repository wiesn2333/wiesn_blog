---
interface Props {
  href: string;
  icon: string;
  title: string;
  description: string;
  tags: string[];
}

const { href, icon, title, description, tags } = Astro.props;
---

<a href={href} class="card">
  <div class="card__body">
    <div class="row">
      <div class="icon">
        <img src={icon} class="icon-img" />
      </div>
      <div class="content">
        <div class="tags">
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <h2 class="title">{title}</h2>
        <p class="desc">{description}</p>
      </div>
      <span class="arrow">→</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 4px;
    border: 1px solid var(--shadow-color);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
    overflow: hidden;
    background: var(--background-color);
    box-shadow: inset 0 -2px 0 0 var(--shadow-color);
  }
  .card:hover {
    border-color: var(--primary-color);
  }

  .card__body {
    padding: 0.75rem;
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .icon {
    flex-shrink: 0;
    border-radius: 4px;
    border: 1px solid var(--shadow-color);
    padding: 0.5rem;
    background: var(--background-color);
  }
  .icon-img {
    width: 2rem;
    height: 2rem;
  }

  .content {
    min-width: 0;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 4px;
    border: 1px solid var(--shadow-color);
    border-radius: 2px;
    font: 0.625rem sans;
    color: var(--label-color);
  }

  .title {
    margin: 0.25rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--primary-color) 20%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .card:hover .title {
    text-decoration-color: var(--primary-color);
  }

  .desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--label-color);
  }

  .arrow {
    display: none;
    flex-shrink: 0;
    align-self: center;
    color: var(--label-color);
    transition: color 0.15s;
  }
  .card:hover .arrow {
    color: var(--primary-color);
  }
  @media (min-width: 640px) {
    .arrow {
      display: block;
    }
  }
</style>
